{
  "name": "@dbquant/vellumpix",
  "version": "0.1.0",
  "description": "Session-aware CLI and MCP bridge to ChatGPT Web for writing, image generation, and model-assisted workflows.",
  "keywords": [
    "browser-automation",
    "chatgpt",
    "image-generation",
    "mcp",
    "writing"
  ],
  "homepage": "https://github.com/dbquant/vellumpix",
  "bugs": {
    "url": "https://github.com/dbquant/vellumpix/issues"
  },
  "license": "MIT",
  "author": "dbquant",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbquant/vellumpix.git"
  },
  "bin": {
    "vellumpix": "dist/bin/vellumpix-cli.js",
    "vellumpix-mcp": "dist/bin/vellumpix-mcp.js"
  },
  "files": [
    "dist/**/*",
    "assets-vellumpix-icon.png",
    "vendor/vellumpix-notifier/VellumPixNotifier.swift",
    "vendor/vellumpix-notifier/VellumPixNotifier.app/**",
    "vendor/vellumpix-notifier/build-notifier.sh",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/bin/vellumpix-cli.js",
  "scripts": {
    "docs:list": "tsx scripts/docs-list.ts",
    "docs:check": "node --no-deprecation --import tsx bin/vellumpix-cli.ts docs check",
    "docs:site": "node scripts/build-docs-site.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && pnpm run build:vendor",
    "build:vendor": "node -e \"const fs=require('fs'); const path=require('path'); const vendorRoot=path.join('dist','vendor'); fs.rmSync(vendorRoot,{recursive:true,force:true}); const vendors=[['vellumpix-notifier']]; vendors.forEach(([name])=>{const src=path.join('vendor',name); const dest=path.join(vendorRoot,name); fs.mkdirSync(dest,{recursive:true}); if(fs.existsSync(src)){fs.cpSync(src,dest,{recursive:true,force:true});}});\"",
    "start": "pnpm run build && node ./dist/scripts/run-cli.js",
    "vellumpix": "pnpm start",
    "check": "pnpm run format:check && pnpm run lint",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "format:diff": "oxfmt --write . && git --no-pager diff",
    "lint": "pnpm run typecheck && oxlint",
    "lint:fix": "oxlint --fix && pnpm run format",
    "test": "vitest run",
    "test:mcp": "pnpm run build && pnpm run test:mcp:unit && pnpm run test:mcp:mcporter",
    "test:mcp:unit": "vitest run tests/mcp*.test.ts tests/mcp/**/*.test.ts",
    "test:mcp:mcporter": "CHROME_DEVTOOLS_URL=http://127.0.0.1:0 pnpm dlx mcporter list vellumpix-local --schema --config config/mcporter.json && CHROME_DEVTOOLS_URL=http://127.0.0.1:0 pnpm dlx mcporter call vellumpix-local.sessions limit:1 --config config/mcporter.json",
    "test:browser": "pnpm run build && tsx scripts/test-browser.ts && ./scripts/browser-smoke.sh",
    "test:packed-cli": "node scripts/packed-cli-smoke.mjs",
    "test:live": "VELLUMPIX_LIVE_TEST=1 vitest run tests/live --exclude tests/live/openai-live.test.ts",
    "test:live:fast": "VELLUMPIX_LIVE_TEST=1 VELLUMPIX_LIVE_TEST_FAST=1 vitest run tests/live/browser-fast-live.test.ts",
    "test:pro": "VELLUMPIX_LIVE_TEST=1 vitest run tests/live/openai-live.test.ts",
    "test:coverage": "vitest run --coverage",
    "prepare": "pnpm run build",
    "mcp": "pnpm run build && node ./dist/bin/vellumpix-mcp.js"
  },
  "dependencies": {
    "@anthropic-ai/tokenizer": "^0.0.4",
    "@google/genai": "^2.31.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@steipete/sweet-cookie": "^0.4.4",
    "chalk": "^6.0.1",
    "chrome-launcher": "^1.2.2",
    "chrome-remote-interface": "^0.34.0",
    "clipboardy": "^5.3.2",
    "commander": "^15.0.0",
    "dotenv": "^18.0.8",
    "fast-glob": "^3.3.3",
    "gpt-tokenizer": "^4.1.0",
    "inquirer": "14.2.4",
    "json5": "^2.2.3",
    "kleur": "^4.1.5",
    "markdansi": "^0.3.7",
    "openai": "^7.43.0",
    "osc-progress": "^0.3.4",
    "qs": "^6.16.1",
    "shiki": "^4.5.0",
    "toasted-notifier": "^10.1.0",
    "tokentally": "^0.1.7",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/chrome-remote-interface": "^0.34.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "devtools-protocol": "0.0.1724436",
    "es-toolkit": "^1.52.0",
    "esbuild": "^0.28.2",
    "oxfmt": "0.74.0",
    "oxlint": "^1.89.0",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "runtime": [
      {
        "name": "node",
        "version": ">=24"
      }
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.28.2"
}
